-#!/usr/bin/env bash
-# Build the scratch harness: a pinned copy of the Nanobot-side harness (factory/ and bin/factory
-# from feat/lionbot-v3) with instance/ overlaid so the roles target this repo. Idempotent.
-set -euo pipefail
