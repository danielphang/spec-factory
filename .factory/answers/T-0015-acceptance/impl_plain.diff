+def _request_frontmatter(text: str) -> tuple[dict, str]:
+    """Split a request into its optional YAML frontmatter mapping and the body after it.
+
+    No header (first line not `---`) gives ({}, text). A header that is never closed, does not
+    parse, or is not a mapping is refused.
+    """
+    lines = text.splitlines(keepends=True)
+    if not lines or lines[0].rstrip("\r\n") != "---":
+        return {}, text
+    end = next((i for i in range(1, len(lines)) if lines[i].rstrip("\r\n") == "---"), None)
+    if end is None:
+        raise Refused("request frontmatter is never closed (no second '---' line)")
+    try:
+        meta = yaml.safe_load("".join(lines[1:end]))
+    except yaml.YAMLError as e:
+        raise Refused(f"request frontmatter is not valid YAML: {e}".replace("\n", " ")) from None
+    if meta is None:
+        meta = {}
+    if not isinstance(meta, dict):
+        raise Refused("request frontmatter is not a key/value mapping")
+    return meta, "".join(lines[end + 1:])
+
+
